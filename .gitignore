# Logs — generated during training
logs/

# Benchmark results — generated by evaluate.py
benchmarks/ablation_results.json

# Environment
.env
venv/
env/
.venv/

# OS files
.DS_Store
Thumbs.db

# IDE files
.vscode/settings.json
.idea/
*.swp

# Model outputs
*.onnx
*.tflite